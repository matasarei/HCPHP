<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        The suite runs silently on PHP 7.4, 8.2, 8.3 and 8.4 with no deprecations, so anything
        printed during a test is a real finding and fails the run. 7.4 remains the supported
        floor: the projects that copy these tests are still on it.
    -->
    <testsuites>
        <testsuite name="HCPHP">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">application/core</directory>
            <directory suffix=".php">application/lib/UserBundle</directory>
        </include>
    </coverage>
</phpunit>
