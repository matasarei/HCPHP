{
  "name": "matasarei/hcphp",
  "description": "A small MVC framework, kept as a reference implementation rather than a package.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Yevhen Matasar",
      "email": "matasar.ei@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "vendor-dir": "application/lib/vendor",
    "platform": {
      "php": "7.4"
    }
  },
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "ext-pdo_sqlite": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text",
    "lint": "find application index.php -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l > /dev/null && php -l run > /dev/null"
  }
}
